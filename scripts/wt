#!/usr/bin/env zsh

# wt — worktree manager for Foundry + cmux
# Usage:
#   wt                       interactive picker (fzf)
#   wt new [branch-name]     new worktree from scratch
#   wt gh <issue-number>     from GitHub issue
#   wt linear <issue-id>     from Linear issue (e.g. FOU-123)
#   wt ls                    list worktrees
#   wt rm <name>             remove worktree + branch

set -euo pipefail

# PATH minimal pour les shells non-interactifs (homebrew + standard macOS)
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# ── Config ──────────────────────────────────────────────────────────────────
FOUNDRY_REPO="${FOUNDRY_REPO:-$HOME/Developer/personal/foundry}"
WORKTREE_BASE="${FOUNDRY_WORKTREE_BASE:-$HOME/conductor/workspaces/foundry}"
GH_REPO="theodaguier/foundry"

# cmux binary — resolve via PATH or fall back to app bundle
_CMUX="${CMUX_BIN:-}"
if [[ -z "$_CMUX" ]]; then
  _CMUX="$(command -v cmux 2>/dev/null || true)"
  [[ -z "$_CMUX" ]] && _CMUX="/Applications/cmux.app/Contents/Resources/bin/cmux"
fi

# ── Helpers ──────────────────────────────────────────────────────────────────
_info()    { printf "\033[34m→\033[0m %s\n" "$*" }
_ok()      { printf "\033[32m✓\033[0m %s\n" "$*" }
_err()     { printf "\033[31m✗\033[0m %s\n" "$*" >&2; exit 1 }
_warn()    { printf "\033[33m!\033[0m %s\n" "$*" }

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed -E 's/-+/-/g' | sed 's/^-//;s/-$//'
}

# Create the worktree dir + git worktree + open in cmux
_create_worktree() {
  local branch="$1"
  local name="$2"         # display name / dir name
  local open="${3:-true}"

  local dest="$WORKTREE_BASE/$name"

  if [[ -d "$dest" ]]; then
    _warn "Worktree already exists at $dest"
  else
    _info "Creating worktree: $name → $branch"
    git -C "$FOUNDRY_REPO" worktree add "$dest" -b "$branch" 2>/dev/null \
      || git -C "$FOUNDRY_REPO" worktree add "$dest" "$branch" 2>/dev/null \
      || _err "Could not create worktree. Branch '$branch' may already exist — try: git -C $FOUNDRY_REPO branch -d $branch"
    _ok "Worktree created at $dest"
  fi

  if [[ "$open" == "true" ]]; then
    _open_in_cmux "$dest" "$name"
  fi
}

_open_in_cmux() {
  local path="$1"
  local name="$2"

  _info "Opening tab: $name"
  local result surface_id ws
  ws="${CMUX_WORKSPACE_ID:-workspace:1}"
  result="$("$_CMUX" new-surface --workspace "$ws" 2>&1)"
  if [[ "$result" != OK* ]]; then
    _warn "cmux: $result — worktree at $path"
    return
  fi
  surface_id="${result[(w)2]}"
  # Attendre que le shell soit prêt, puis naviguer et renommer
  /bin/sleep 2.0
  "$_CMUX" send     --surface "$surface_id" --workspace "$ws" "cd $path" && \
  "$_CMUX" send-key --surface "$surface_id" --workspace "$ws" "Enter"
  /bin/sleep 0.5
  "$_CMUX" rename-tab --surface "$surface_id" --workspace "$ws" "$name"
  _ok "Tab opened: $name"
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_new() {
  local branch="${1:-}"

  if [[ -z "$branch" ]]; then
    printf "Branch name: "
    read -r branch
  fi

  [[ -z "$branch" ]] && _err "Branch name is required"

  local name
  name="$(slugify "$branch")"
  _create_worktree "$branch" "$name"
}

cmd_gh() {
  local issue_number="${1:-}"
  [[ -z "$issue_number" ]] && _err "Usage: wt gh <issue-number>"

  _info "Fetching GitHub issue #$issue_number..."

  local json
  json="$(gh issue view "$issue_number" --repo "$GH_REPO" --json number,title,labels 2>/dev/null)" \
    || _err "GitHub issue #$issue_number not found"

  local title number
  title="$(echo "$json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['title'])")"
  number="$(echo "$json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['number'])")"

  local slug
  slug="$(slugify "$title")"
  local branch="$number-${slug:0:50}"
  local name="gh-${number}-${slug:0:40}"

  _info "Issue: #$number — $title"
  _info "Branch: $branch"

  _create_worktree "$branch" "$name"
}

cmd_linear() {
  local issue_id="${1:-}"
  [[ -z "$issue_id" ]] && _err "Usage: wt linear <issue-id>  (e.g. FOU-123)"

  local api_key="${LINEAR_API_KEY:-}"
  if [[ -z "$api_key" ]]; then
    # Try reading from config file
    local cfg="$HOME/.config/linear/token"
    [[ -f "$cfg" ]] && api_key="$(cat "$cfg")"
  fi

  [[ -z "$api_key" ]] && _err "LINEAR_API_KEY not set. Export it or save to ~/.config/linear/token"

  _info "Fetching Linear issue $issue_id..."

  local query
  query=$(cat <<'GQL'
{"query":"query($id:String!){issue(id:$id){identifier title branchName url state{name}}}","variables":{"id":"ISSUE_ID"}}
GQL
)
  query="${query/ISSUE_ID/$issue_id}"

  local response
  response="$(curl -sf -X POST https://api.linear.app/graphql \
    -H "Authorization: $api_key" \
    -H "Content-Type: application/json" \
    -d "$query")" || _err "Linear API request failed"

  local title branch_name
  title="$(echo "$response" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['issue']['title'])")" \
    || _err "Could not parse Linear response (check issue ID and API key)"
  branch_name="$(echo "$response" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['issue']['branchName'])")"

  local slug
  slug="$(slugify "$issue_id")"
  local name="linear-${slug}-$(slugify "${title:0:40}")"

  _info "Issue: $issue_id — $title"
  _info "Branch: $branch_name"

  _create_worktree "$branch_name" "$name"
}

cmd_ls() {
  _info "Foundry worktrees:"
  git -C "$FOUNDRY_REPO" worktree list | grep -v "\.claude/worktrees" | column -t
}

cmd_rm() {
  local name="${1:-}"
  [[ -z "$name" ]] && _err "Usage: wt rm <worktree-name>"

  local dest="$WORKTREE_BASE/$name"
  [[ ! -d "$dest" ]] && _err "No worktree found at $dest"

  local branch
  branch="$(git -C "$FOUNDRY_REPO" worktree list | grep "$dest" | awk '{print $3}' | tr -d '[]')"

  printf "Remove worktree '%s' (branch: %s)? [y/N] " "$name" "$branch"
  read -r confirm
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && exit 0

  git -C "$FOUNDRY_REPO" worktree remove "$dest" --force
  _ok "Worktree removed"

  if [[ -n "$branch" && "$branch" != "main" && "$branch" != "master" ]]; then
    printf "Delete branch '%s' too? [y/N] " "$branch"
    read -r del_branch
    if [[ "$del_branch" == "y" || "$del_branch" == "Y" ]]; then
      git -C "$FOUNDRY_REPO" branch -D "$branch" && _ok "Branch deleted"
    fi
  fi
}

cmd_pick() {
  # fzf interactive: switch to existing worktree or create new
  local options
  options="$(git -C "$FOUNDRY_REPO" worktree list | grep -v "\.claude/worktrees" | awk '{print $1}')"

  local extra="── new worktree ──\n── gh issue ──\n── linear issue ──"
  local selection
  selection="$(printf "%s\n%b" "$options" "$extra" | fzf --prompt="worktree> " --height=40% --reverse)" || exit 0

  case "$selection" in
    "── new worktree ──")  cmd_new ;;
    "── gh issue ──")
      printf "GitHub issue number: "
      read -r n; cmd_gh "$n" ;;
    "── linear issue ──")
      printf "Linear issue ID (e.g. FOU-123): "
      read -r id; cmd_linear "$id" ;;
    *)
      local name
      name="$(basename "$selection")"
      _open_in_cmux "$selection" "$name"
      ;;
  esac
}

# ── Entry point ───────────────────────────────────────────────────────────────
case "${1:-}" in
  new)     shift; cmd_new "$@" ;;
  gh)      shift; cmd_gh "$@" ;;
  linear)  shift; cmd_linear "$@" ;;
  ls|list) cmd_ls ;;
  rm|remove) shift; cmd_rm "$@" ;;
  "")      cmd_pick ;;
  *)       _err "Unknown command: $1\nUsage: wt [new|gh|linear|ls|rm]" ;;
esac
